{
  "name": "claude-peer-channel",
  "version": "0.1.1",
  "description": "Local hub that lets Claude Code sessions talk to each other via MCP channel",
  "type": "module",
  "bin": {
    "peer-channel": "dist/channel/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:plugin": "esbuild src/channel/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=plugin/channel.js",
    "dev:channel": "tsx src/channel/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
